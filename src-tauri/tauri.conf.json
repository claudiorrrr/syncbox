{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syncbox",
  "version": "0.4.1",
  "identifier": "dev.syncbox",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "syncbox",
        "label": "main",
        "width": 480,
        "height": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Simple Mac folder sync",
    "longDescription": "Pick a folder, pair two Macs, files sync between them."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MjVBOUVFMEVBQ0RENUMKUldSYzNhd083cWtsZGZGbUt5VUtVd2Zwc2NmaFY4dklaRStSYUQvbE9MMFpJNkRkQjhTbG92a04K",
      "endpoints": [
        "https://github.com/claudiorrrr/syncbox/releases/latest/download/latest.json"
      ]
    }
  }
}
