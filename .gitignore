# Rust — workspace builds into the root target/, but a stale src-tauri/target/
# can linger from the pre-workspace layout, so ignore it anywhere.
target/

# Node
/node_modules/
/dist/

# Tauri build artifacts
/src-tauri/gen/
/src-tauri/WixTools/

# macOS
.DS_Store

# Local data
*.log

# Secrets — never commit. Nothing in this project needs one today, but if a
# future feature does, this keeps it out of git by default.
.env
.env.*
*.pem
*.key

# Build-time default pair-server host — personal, kept out of the repo.
/pair-server.txt

# Release credentials for scripts/release.sh — copy from release-env.sh.example.
/scripts/release-env.sh

# Icon raster — derived from app-icon.svg, regenerate with `tauri icon`.
/app-icon.png
